# Server
PORT=3001
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
DATA_DIR=.data
APP_ENCRYPTION_KEY=

# Gemini (optional; users may also configure it in the Settings screen)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ComfyUI (optional; defaults to local ComfyUI)
# Leave COMFYUI_WORKFLOW_JSON empty to use server/providers/workflows/product-enhance.json.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_JSON=
COMFYUI_RUNTIME=local
COMFYUI_TIMEOUT_MS=300000
COMFYUI_POLL_MS=1000
# Used only to warn when the detected GPU is small; it does not block local processing.
COMFYUI_MIN_VRAM_GB=6
# Optional exact checkpoint name; otherwise the first compatible checkpoint from /object_info is selected.
# The supplied installer downloads v1-5-pruned-emaonly.safetensors (CreativeML OpenRAIL-M).
COMFYUI_CHECKPOINT=

# Meta/Facebook OAuth (required for real Fanpage connection)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/facebook/oauth/callback
META_GRAPH_VERSION=v21.0
