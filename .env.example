# Server
PORT=3001
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
DATA_DIR=.data
APP_ENCRYPTION_KEY=

# Gemini (optional; users may also configure it in the Settings screen)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ComfyUI (optional; defaults to local ComfyUI)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_JSON=

# Meta/Facebook OAuth (required for real Fanpage connection)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/facebook/oauth/callback
META_GRAPH_VERSION=v21.0
