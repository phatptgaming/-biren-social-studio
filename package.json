{
  "name": "biren-social-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Biren Social Studio - công cụ AI hỗ trợ tạo và đăng bài Facebook Fanpage.",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-workflows.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck && npm run build",
    "comfy:check": "powershell -ExecutionPolicy Bypass -File .\\scripts\\comfyui\\Manage-ComfyUI.ps1 -Action check",
    "comfy:install": "powershell -ExecutionPolicy Bypass -File .\\scripts\\comfyui\\Manage-ComfyUI.ps1 -Action install",
    "comfy:start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\comfyui\\Manage-ComfyUI.ps1 -Action start",
    "comfy:stop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\comfyui\\Manage-ComfyUI.ps1 -Action stop",
    "comfy:status": "powershell -ExecutionPolicy Bypass -File .\\scripts\\comfyui\\Manage-ComfyUI.ps1 -Action status"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
